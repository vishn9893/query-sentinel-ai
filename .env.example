# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | huggingface
LLM_PROVIDER=ollama

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=VISHNUDHAT/wazuh-llama-3.1-8b-assistant-Q4_K_M-GGUF
OLLAMA_TIMEOUT=120

# ── HuggingFace (optional fallback) ──────────────────────────────────────────
HF_API_TOKEN=
HF_MODEL=VISHNUDHAT/wazuh-llama-3.1-8b-assistant-Q4_K_M-GGUF

# ── Wazuh API ─────────────────────────────────────────────────────────────────
# Leave blank to use built-in mock data for development
WAZUH_API_URL=
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=

# ── Elasticsearch / OpenSearch ────────────────────────────────────────────────
# Leave blank to use mock data for development
ELASTIC_URL=
ELASTIC_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
